bool connectToGPRS() {
    logInfo("Connecting to GPRS...");
    
    if (modem.isGprsConnected()) {
        modem.gprsDisconnect();
        safeDelay(1000);
    }
    
    if (modem.gprsConnect(apn, user, pass)) {
        safeDelay(2000);
        String ip = modem.getLocalIP();
        logInfo("GPRS connected, IP: " + ip);
        recovery.gprsFailures = 0;
        return true;
    }
    
    logError("GPRS connection failed");
    recovery.gprsFailures++;
    return false;
}

// ============================================================================
// MQTT FUNCTIONS
// ============================================================================

void mqttCallback(char* topic, byte* payload, unsigned int length) {
    char message[128];
    unsigned int copyLen = length < 127 ? length : 127;
    memcpy(message, payload, copyLen);
    message[copyLen] = '\0';
    
    logInfo("CMD: " + String(topic) + " = " + String(message));
    
    if (String(topic) == topicSub) {
        if (strcmp(message, "RESTART") == 0) {
            logInfo("Remote restart command received");
            safeDelay(100);
            systemRestart();
        } else if (strcmp(message, "RESET_MODEM") == 0) {
            currentState = STATE_RECOVER_MODEM_SOFT;
        }
    }
    
    lastMqttActivity = millis();
}

bool connectToMQTT() {
    if (mqtt.connected()) return true;
    
    logInfo("Connecting to MQTT...");
    mqtt.disconnect();
    safeDelay(250);
    
    String clientId = "GW" + String((uint32_t)ESP.getEfuseMac(), HEX).substring(0, 8);
    
    mqtt.setServer(broker, brokerPort);
    mqtt.setCallback(mqttCallback);
    mqtt.setKeepAlive(MQTT_KEEPALIVE);
    mqtt.setSocketTimeout(MQTT_SOCKET_TIMEOUT);
    
    bool connected = mqtt.connect(clientId.c_str(), mqttUser, mqttPass);
    
    if (connected) {
        logInfo("MQTT connected");
        
        if (mqtt.subscribe(topicSub)) {
            logInfo("Subscribed to: " + String(topicSub));
        }
        
        char statusMsg[64];
        snprintf(statusMsg, 64, "ONLINE|rssi:%d|reset:%d", 
                 modem.getSignalQuality(), recovery.hardResets + recovery.softResets);
        mqtt.publish(topicStatus, statusMsg);
        
        publishQueuedMessages();
        
        recovery.mqttFailures = 0;
        recovery.lastSuccessfulPublish = millis();
        lastMqttActivity = millis();
        return true;
    }
    
    int state = mqtt.state();
    logError("MQTT failed, state: " + String(state));
    recovery.mqttFailures++;
    return false;
}

void publishData() {
    if (!mqtt.connected()) return;
    
    char payload[256];
    snprintf(payload, sizeof(payload),
        "{"
        "\"ts\":%lu,"
        "\"rssi\":%d,"
        "\"rssi_pct\":%d,"
        "\"state\":%d,"
        "\"uptime\":%lu,"
        "\"gprs_retry\":%d,"
        "\"mqtt_retry\":%d,"
        "\"soft_resets\":%d,"
        "\"hard_resets\":%d"
        "}",
        millis() / 1000,
        modem.getSignalQuality(),
        // getSignalPercent(),
        modem.getSignalQuality(),
        currentState,
        millis() / 1000,
        recovery.gprsFailures,
        recovery.mqttFailures,
        recovery.softResets,
        recovery.hardResets
    );
    
    if (mqtt.publish(topicPub, payload)) {
        recovery.lastSuccessfulPublish = millis();
    } else {
        logWarn("Publish failed, queuing");
        msgQueue.push(topicPub, payload);
    }
}

void publishQueuedMessages() {
    MessageQueue::Message msg;
    while (msgQueue.pop(msg)) {
        if (mqtt.connected()) {
            if (millis() - msg.timestamp < 300000) {
                mqtt.publish(msg.topic, msg.payload);
            }
        } else {
            if (msgQueue.count < MessageQueue::MAX_SIZE - 1) {
                msgQueue.push(msg.topic, msg.payload);
            }
            break;
        }
        safeDelay(10);
    }
}

void mqttKeepAlive() {
    if (mqtt.connected()) {
        if (millis() - lastMqttActivity > MQTT_PING_INTERVAL) {
            mqtt.publish(topicStatus, "PING", true);
            lastMqttActivity = millis();
            lastMqttKeepAlive = millis();
        }
    }
}

// ============================================================================
// DIAGNOSTICS
// ============================================================================

bool runDiagnostics() {
    logInfo("Running diagnostics...");
    
    bool allOk = true;
    
    if (!simStatus()) {
        logError("SIM failure");
        allOk = false;
    }
    
    int signal = modem.getSignalQuality();
    if (signal == 99 || signal < 6) {
        logError("Poor signal: " + String(signal));
        allOk = false;
    } else {
        SerialMon.printf("Signal: %d (%d%%)\n", signal, modem.getSignalQuality());
    }
    
    if (!modem.isNetworkConnected()) {
        logError("Not registered on network");
        allOk = false;
    }
    
    // FIXED: Skip broker check during diagnostics to avoid crash
    // Just check internet ping instead
    if (!checkInternet()) {
        logError("No internet access");
        allOk = false;
    } else {
        logInfo("Internet OK");
    }
    
    return allOk;
}

// ============================================================================
// SYSTEM MANAGEMENT
// ============================================================================

void systemRestart() {
    logError("System restart initiated");
    logInfo("Stats - Uptime: " + String(millis() / 1000) + "s");
    
    safeDelay(500);
    SerialMon.flush();
    SerialAT.flush();
    safeDelay(500);
    ESP.restart();
    
    while (1) {
        delay(1000);
    }
}

void checkWatchdog() {
    static SystemState lastState = STATE_BOOTING;
    
    if (currentState != lastState) {
        lastStateEntry = millis();
        lastState = currentState;
        logInfo("State: " + String(currentState));
    }
    
    // if (millis() - lastStateEntry > OPERATION_TIMEOUT) {
    if (OPERATION_TIMEOUT > 0 && millis() - lastStateEntry > OPERATION_TIMEOUT) {
        logError("State timeout, forcing restart");
        systemRestart();
    }
    
    if (millis() - lastWatchdog > WATCHDOG_INTERVAL) {
        lastWatchdog = millis();
        
        if (currentState == STATE_NORMAL && 
            millis() - recovery.lastSuccessfulPublish > 300000) {
            logWarn("No successful publish for 5 min");
            currentState = STATE_RECOVER_MQTT;
        }
    }
}

// ============================================================================
// INITIALIZATION
// ============================================================================

bool initializeSystem() {
    logInfo("Initializing system...");
    
    SerialAT.begin(115200, SERIAL_8N1, MODEM_RX, MODEM_TX);
    modemPowerOn();
    
    if (!modem.testAT()) {
        logError("Modem not responding");
        return false;
    }
    
    // Disable echo for cleaner communication
    modem.sendAT("E0");
    modem.waitResponse();
    
    modem.sendAT("+CMEE=2");
    modem.waitResponse();
    
    modem.sendAT("+CREG=2");
    modem.waitResponse();
    
    modem.sendAT("+CSCLK=0");
    modem.waitResponse();
    
    return true;
}

// ============================================================================
// MAIN SETUP
// ============================================================================

void setup() {
    SerialMon.begin(115200);
    delay(1000);
    
    SerialMon.println("\n\n");
    SerialMon.println("╔══════════════════════════════════════════════════════╗");
    SerialMon.println("║     A7670E 24/7 PRODUCTION GATEWAY v3.1              ║");
    SerialMon.println("║     Industrial Grade | Auto-Recovery | Fail-Safe     ║");
    SerialMon.println("╚══════════════════════════════════════════════════════╝\n");
    
    pinMode(MODEM_PWRKEY, OUTPUT);
    digitalWrite(MODEM_PWRKEY, LOW);
    
    modemPowerOff();
    safeDelay(1000);
    
    if (!initializeSystem()) {
        logError("System initialization failed");
        safeDelay(2000);
        systemRestart();
    }
    
    currentState = STATE_NETWORK_WAIT;
    lastStateEntry = millis();
    
    logInfo("Setup complete, entering main loop");
}

// ============================================================================
// MAIN LOOP
// ============================================================================

void loop() {
    checkWatchdog();
    
    switch (currentState) {

        case STATE_NORMAL:
            if (!modem.isGprsConnected()) {
                logWarn("GPRS lost in normal mode");
                currentState = STATE_RECOVER_GPRS;
                break;
            }
            
            if (!mqtt.connected()) {
                if (!modem.isGprsConnected()) {
                    mqtt.disconnect();
                    currentState = STATE_RECOVER_GPRS;
                    break;
                } else {
                    currentState = STATE_RECOVER_MQTT;
                    break;
                }
                break;
            }
            
            mqtt.loop();
            mqttKeepAlive();
            
            if (millis() - lastPublish > PUBLISH_INTERVAL) {
                lastPublish = millis();
                publishData();
            }
            
            if (millis() - lastStatus > STATUS_PRINT_INTERVAL) {
                lastStatus = millis();
                SerialMon.printf("[STATUS] GPRS:%d MQTT:%d RSSI:%d%% S:%d\n",
                    modem.isGprsConnected(),
                    mqtt.connected(),
                    // getSignalPercent(),
                    modem.getSignalQuality(),
                    currentState);
            }
            
            if (millis() - lastDiagnostic > DIAGNOSTIC_INTERVAL) {
                lastDiagnostic = millis();
                runDiagnostics();
            }
            
            safeDelay(100);
            break;

        case STATE_RECOVER_MQTT:
            for (int i=0 ; i<3 ; i++) {
                if (connectToMQTT()) {
                    fail.mqttFailures = 0;
                    currentState = STATE_NORMAL;
                    break;
                }
                delay(2000);
            }
            fail.mqttFailures++;
            if (fail.mqttFailures > maxx.mqttMaxRetrys) {
                currentState = STATE_IDLE;
            }
            if (!modem.isGprsConnected()) {
                currentState = STATE_RECOVER_GPRS;
            }
            break;
            
        case STATE_RECOVER_GPRS:
            if (modem.isGprsConnected()) {
                currentState = STATE_RECOVER_MQTT;
                break;
            }
            if (modem.gprsConnect(apn, user, pass)) {
                currentState = STATE_RECOVER_MQTT;
                break;
            }
            modem.gprsDisconnect();
            for (int i=0 ; i<3 ; i++) {
                if (connectToGPRS()) {
                    currentState = STATE_RECOVER_MQTT;
                    break;
                }
                delay(2000);
            }
            fail.gprsFailures++;
            if (fail.gprsFailures > maxx.gprsMaxRetrys) {
                currentState = STATE_IDLE;
            }
            
            if (!diagnosticsModem()) {
                if(!modemSoftReset()) {
                    modemPowerOff();
                    for (int i=0 ; i<5000 ; i++) {
                        delay(2);
                    }
                    modemPowerOn();
                    currentState = STATE_RECOVER_GPRS;
                }
            }
            break;



        case STATE_IDLE:
            fail.deviceIdle++;
            for (int i=0 ; i<30 ; i++) delay(2);
            if (fail.deviceIdle > maxx.idleMaxRetrys) {
                currentState = STATE_CRITICAL;
            }
            
            break;
        case STATE_CRITICAL:
            logError("Critical state - restarting in 10s");
            safeDelay(10000);
            systemRestart();
            break;
            
        default:
            currentState = STATE_NORMAL;
            break;
    }
}

