// ============================================================================
// STRUCTURES
// ============================================================================
struct RecoveryCounters {
    uint8_t gprsFailures = 0;
    uint8_t mqttFailures = 0;
    uint8_t softResets = 0;
    uint8_t hardResets = 0;
    uint32_t lastSuccessfulPublish = 0;
    uint32_t lastMqttPing = 0;
};

struct FailCounters {
    uint8_t gprsFailures = 0;
    uint8_t mqttFailures = 0;
    uint8_t deviceIdle = 0;
};
struct MaxRetry {
    uint8_t gprsMaxRetrys = 3;
    uint8_t mqttMaxRetrys = 3;
    uint8_t idleMaxRetrys = 3;
};

struct MessageQueue {
    static const int MAX_SIZE = 10;
    struct Message {
        char topic[64];
        char payload[128];
        unsigned long timestamp;
    } messages[MAX_SIZE];
    int head = 0;
    int tail = 0;
    int count = 0;
    
    bool push(const char* topic, const char* payload) {
        if (count >= MAX_SIZE) return false;
        strncpy(messages[tail].topic, topic, 63);
        messages[tail].topic[63] = '\0';
        strncpy(messages[tail].payload, payload, 127);
        messages[tail].payload[127] = '\0';
        messages[tail].timestamp = millis();
        tail = (tail + 1) % MAX_SIZE;
        count++;
        return true;
    }
    
    bool pop(Message& msg) {
        if (count == 0) return false;
        msg = messages[head];
        head = (head + 1) % MAX_SIZE;
        count--;
        return true;
    }
    
    bool isEmpty() { return count == 0; }
};

