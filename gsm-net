// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

bool simStatus() {
    SimStatus status = modem.getSimStatus();
    if (status != SIM_READY) {
        logError("SIM not ready");
        return false;
    }
    return true;
}

bool waitForNetwork() {
    logInfo("Waiting for network registration...");
    
    unsigned long start = millis();
    while (millis() - start < NETWORK_TIMEOUT) {
        if (modem.isNetworkConnected()) {
            String op = modem.getOperator();
            logInfo("Network: " + op);
            return true;
        }
        
        if ((millis() - start) % 5000 < 1000) {
            int reg = modem.getRegistrationStatus();
            SerialMon.printf("Registration status: %d\n", reg);
        }
        
        safeDelay(1000);
    }
    
    logError("Network timeout");
    return false;
}

bool diagnosticsModem() {
    if (!modem.testAT(6000)) return false;

    if (!simStatus()) return false;

    if (!waitForNetwork())  return false;

    if (modem.getSignalQuality() == 99) return false;

    return true;
}

void safeDelay(unsigned long ms) {
    unsigned long start = millis();
    while (millis() - start < ms) {
        if (currentState == STATE_NORMAL && mqtt.connected()) {
            mqtt.loop();
        }
        delay(10);
    }
}


// FIXED: Safe internet check without crashing
bool checkInternet() {
    logDebug("Checking internet...");
    
    // Use AT command ping instead of TCP connect (more reliable)
    modem.sendAT("+CIPPING=\"8.8.8.8\",1,32,2000");
    
    // Wait for response (max 5 seconds)
    unsigned long start = millis();
    while (millis() - start < 5000) {
        if (modem.waitResponse(1000L, "+CIPPING:") == 1) {
            logDebug("Internet ping successful");
            return true;
        }
        // Check for timeout response
        if (modem.waitResponse(100L, "ERROR") == 1) {
            logDebug("Internet ping failed");
            return false;
        }
    }
    
    logDebug("Internet ping timeout");
    return false;
}

// FIXED: Safe broker check with timeout and proper cleanup
bool checkBroker() {
    logDebug("Checking broker...");
    
    // Create a new client instance
    TinyGsmClient* testClient = new TinyGsmClient(modem);
    
    if (!testClient) {
        logError("Failed to create test client");
        return false;
    }
    
    // Set timeout
    testClient->setTimeout(5000);
    
    // Attempt connection
    bool connected = testClient->connect(broker, brokerPort);
    
    if (connected) {
        logDebug("Broker reachable");
        testClient->stop();
    } else {
        logDebug("Broker unreachable");
    }
    
    // Clean up
    testClient->stop();
    delete testClient;
    
    return connected;
}

// ============================================================================
// MODEM POWER MANAGEMENT
// ============================================================================

void modemPowerOn() {
    logInfo("Powering ON modem...");
    
    pinMode(MODEM_PWRKEY, OUTPUT);
    digitalWrite(MODEM_PWRKEY, HIGH);
    delay(500);
    digitalWrite(MODEM_PWRKEY, LOW);
    
    safeDelay(3000);
    
    for (int i = 0; i < 20; i++) {
        if (modem.testAT()) {
            logInfo("Modem responded to AT");
            return;
        }
        safeDelay(500);
    }
    
    logError("Modem power-on failed");
}

void modemPowerOff() {
    logInfo("Powering OFF modem...");
    
    pinMode(MODEM_PWRKEY, OUTPUT);
    digitalWrite(MODEM_PWRKEY, HIGH);
    safeDelay(2000);
    digitalWrite(MODEM_PWRKEY, LOW);
    
    safeDelay(2000);
}

// ============================================================================
// MODEM RESET FUNCTIONS
// ============================================================================

bool modemSoftReset() {
    if (millis() - recovery.lastMqttPing < RESET_COOLDOWN && recovery.softResets > 0) {
        logWarn("Soft reset cooldown active");
        return false;
    }
    
    logInfo("Performing soft reset...");
    recovery.lastMqttPing = millis();
    
    modem.restart();
    safeDelay(5000);
    
    for (int i = 0; i < 30; i++) {
        if (modem.testAT()) {
            recovery.softResets++;
            logInfo("Soft reset successful");
            return true;
        }
        safeDelay(500);
    }
    
    logError("Soft reset failed");
    return false;
}

bool modemHardReset() {
    if (millis() - recovery.lastMqttPing < HARD_RESET_COOLDOWN && recovery.hardResets > 0) {
        logWarn("Hard reset cooldown active");
        return false;
    }
    
    logInfo("Performing hard reset...");
    recovery.lastMqttPing = millis();
    
    // Power cycle instead of GPIO reset (more reliable for SIM7600)
    modemPowerOff();
    safeDelay(3000);
    modemPowerOn();
    safeDelay(3000);
    
    if (modem.testAT()) {
        recovery.hardResets++;
        logInfo("Hard reset successful");
        return true;
    }
    
    logError("Hard reset failed");
    return false;
}

bool modemPowerCycle() {
    logInfo("Power cycling modem...");
    modemPowerOff();
    safeDelay(5000);
    modemPowerOn();
    safeDelay(5000);
    return modem.testAT();
}

