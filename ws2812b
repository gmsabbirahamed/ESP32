//fastled/FastLED @ 3.9.16

#include <Arduino.h>
#include <FastLED.h>

#define LED_PIN 13
#define NUM_LEDS 1

CRGB leds[NUM_LEDS];

void setup()
{
    Serial.begin(115200);
    delay(1000);

    Serial.println("ESP32 WS2812B TEST");

    FastLED.addLeds<WS2812B, LED_PIN, GRB>(leds, NUM_LEDS);
    FastLED.setBrightness(80);

    //leds[0] = CRGB(80, 0, 0);
    Serial.println("RED");
    leds[0] = CRGB::Red;
    FastLED.show();

    delay(2000);

    Serial.println("GREEN");
    leds[0] = CRGB::Green;
    FastLED.show();

    delay(2000);

    Serial.println("BLUE");
    leds[0] = CRGB::Blue;
    FastLED.show();
}

void loop()
{
    Serial.println("RED");
    leds[0] = CRGB::Red;
    FastLED.show();
    delay(2000);

    Serial.println("GREEN");
    leds[0] = CRGB::Green;
    FastLED.show();
    delay(2000);

    Serial.println("BLUE");
    leds[0] = CRGB::Blue;
    FastLED.show();
    delay(2000);

    Serial.println("RAINBOW - 5 seconds");

    unsigned long startTime = millis();
    static uint8_t hue = 0;

    while (millis() - startTime < 5000) {
        leds[0] = CHSV(hue, 255, 255);
        FastLED.show();

        hue += 5;
        delay(50);
    }
}

